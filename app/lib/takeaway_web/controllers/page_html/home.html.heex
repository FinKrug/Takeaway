<Layouts.app flash={@flash} wide>
  <section class="pt-2 sm:pt-6" id="hero">
    <.badge tone="brand" class="mb-4"><.live_dot /> For live talks</.badge>
    <h1 class="max-w-2xl font-display text-[2.25rem] font-semibold leading-[1.05] tracking-tight text-balance sm:text-5xl">
      Take more away from <span class="text-brand">every talk.</span>
    </h1>
    <p class="mt-4 max-w-xl text-pretty text-lg text-muted">
      Ask the speaker questions while they talk, keep your own notes in one place,
      and leave with a summary of what mattered.
    </p>
    <p class="mt-4 text-sm text-muted">
      <.link
        :if={@current_organizer}
        id="organizer-dashboard-link"
        href={~p"/organizers"}
        class="inline-flex items-center gap-1 font-semibold text-brand-strong underline-offset-4 hover:underline"
      >
        Your events and tickets <.icon name="hero-arrow-right-mini" class="size-4" />
      </.link>
      <span :if={!@current_organizer}>
        Running an event?
        <.link
          id="organizer-login-link"
          href={~p"/organizers/log_in"}
          class="font-semibold text-brand-strong underline-offset-4 hover:underline"
        >
          Organizer log in
        </.link>
      </span>
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-2 sm:gap-5">
    <.card id="join" tone="brand" class="scroll-mt-24">
      <div class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-xl bg-brand text-on-brand">
          <.icon name="hero-qr-code" class="size-5" />
        </span>
        <div>
          <h2 class="font-display text-lg font-semibold tracking-tight">Join with code</h2>
          <p class="text-sm text-muted">You're in the audience.</p>
        </div>
      </div>

      <form id="join-form" action={~p"/join"} method="get" class="mt-5 space-y-3">
        <label for="join-code-input" class="sr-only">Join code</label>
        <input
          id="join-code-input"
          name="code"
          type="text"
          required
          maxlength="12"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          enterkeyhint="go"
          placeholder="ABC234"
          class="block h-14 w-full rounded-xl border border-control bg-surface px-4 text-center font-mono text-2xl font-semibold uppercase tracking-[0.3em] text-ink shadow-sm shadow-black/[0.02] transition-[border-color,box-shadow] duration-150 placeholder:text-muted/40 placeholder:tracking-[0.3em] hover:border-ink/60 focus:border-brand focus:outline-none focus:ring-4 focus:ring-brand/15"
        />
        <.button type="submit" size="lg" class="w-full" id="join-submit">
          Join speech <.icon name="hero-arrow-right-mini" class="size-5" />
        </.button>
      </form>
    </.card>

    <.card id="create" class="flex flex-col">
      <div class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-xl bg-sunken text-ink">
          <.icon name="hero-presentation-chart-bar" class="size-5" />
        </span>
        <div>
          <h2 class="font-display text-lg font-semibold tracking-tight">Create a speech</h2>
          <p class="text-sm text-muted">You're the speaker.</p>
        </div>
      </div>
      <p class="mt-5 flex-1 text-pretty text-muted">
        Upload your plan and slides, share a six-letter code, and see the audience's
        questions ranked live while you talk.
      </p>
      <.button
        navigate={~p"/speeches/new"}
        variant="secondary"
        size="lg"
        class="mt-5 w-full"
        id="create-speech-link"
      >
        Create a speech
      </.button>
    </.card>
  </div>

  <section id="how-it-works" aria-labelledby="how-it-works-title" class="pt-4">
    <h2 id="how-it-works-title" class="font-display text-lg font-semibold tracking-tight">
      How it works
    </h2>
    <ol class="mt-4 grid gap-3 sm:grid-cols-3">
      <li :for={
        {icon, title, text} <- [
          {"hero-key", "Join in seconds",
           "Type the code from the speaker's slide. Nothing to install."},
          {"hero-chat-bubble-left-right", "Ask and take notes",
           "Send questions to the speaker and keep private notes as the talk goes."},
          {"hero-document-text", "Leave with a summary",
           "When the talk ends, get cliffnotes merged with your own notes."}
        ]
      }>
        <.card tone="sunken" class="h-full">
          <.icon name={icon} class="size-5 text-brand" />
          <h3 class="mt-3 font-semibold">{title}</h3>
          <p class="mt-1 text-pretty text-sm text-muted">{text}</p>
        </.card>
      </li>
    </ol>
  </section>
</Layouts.app>
